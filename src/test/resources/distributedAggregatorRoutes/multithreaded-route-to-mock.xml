<routes xmlns="https://camel.apache.org/schema/spring/camel-spring-4.12.0.xsd">
    <route id="direct-reliable">
      <from uri="seda:start?concurrentConsumers=10"/>
      <onException>
           <exception>org.nhindirect.monitor.repository.AggregationVersionException</exception>
           <redeliveryPolicy maximumRedeliveries="-1" redeliveryDelay="200" collisionAvoidanceFactor="0.15"/>
      </onException>      
      <aggregate aggregationStrategy="aggregationStrategy" ignoreInvalidCorrelationKeys="true"
           aggregationRepository="directMonitoringRepo">
        <correlationExpression>
            <ref>msgIdCorrelator</ref>
        </correlationExpression>
        <completionPredicate> 
          <method>aggregationStrategy?method=isAggregationComplete</method>
        </completionPredicate>     
        <completionTimeoutExpression>
          <method>aggregationStrategy?method=getAggregationTime</method>
        </completionTimeoutExpression>           
        <to uri="mock:result"/>
      </aggregate>
    </route>
</routes>
